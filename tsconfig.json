{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "paths": {
      "@polygraph/core": [
        "./packages/core/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src",
    "apps/*/src"
  ]
}